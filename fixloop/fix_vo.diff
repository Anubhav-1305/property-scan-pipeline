+def _plausible(T):
+    ang = np.degrees(np.arccos(np.clip((np.trace(T[:3, :3]) - 1) / 2, -1, 1)))
+    return np.linalg.norm(T[:3, 3]) < MAX_STEP_M and ang < MAX_STEP_DEG
